# Copia este archivo como .env y completa los valores. El .env NO se sube a Git.
DB_USERNAME=ADMIN
DB_PASSWORD=
# Ruta ABSOLUTA a la carpeta del wallet de Oracle en tu equipo
TNS_ADMIN=/ruta/a/Wallet_XXXX
DB_TNS_ALIAS=q5x4fu7bstfvswj5_high

# Wallet completo para Docker/ECS: zip del wallet (archivos en la raiz, sin carpeta) en base64, una sola linea
#   macOS: base64 -i Wallet_XXXX.zip | tr -d '\n'
#   Linux: base64 -w0 Wallet_XXXX.zip
ORACLE_WALLET_BASE64=
